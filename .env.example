# Copy to .env (gitignored) and fill in. `scripts/setup.sh` / `scripts/setup.ps1` does this for you
# and generates random secrets.

# ---- mhsquare backend ----
MHSQUARE_ENV=development
# 64+ random chars. Used to sign media URLs. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
MHSQUARE_SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
# Single-user login, created on first API start if no user exists.
MHSQUARE_ADMIN_EMAIL=me@example.com
MHSQUARE_ADMIN_PASSWORD=change-me-please
# Origin the UI is served from (CORS + CSRF origin check).
MHSQUARE_UI_ORIGIN=http://localhost:8080
# Secure cookies. Browsers accept Secure cookies on http://localhost; set false only for
# plain-HTTP access from another hostname (not recommended — use Tailscale/Cloudflare Tunnel with TLS).
MHSQUARE_COOKIE_SECURE=true

# ---- postgres ----
POSTGRES_USER=mhsquare
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=mhsquare

# ---- litellm proxy ----
# Admin key for the proxy (only used to create virtual keys / read spend). Must start with "sk-".
LITELLM_MASTER_KEY=sk-change-me-master
# Virtual key for mhsquare with max_budget + budget_duration=1d (see litellm/README.md).
MHSQUARE_LITELLM_API_KEY=sk-change-me-virtual
# Provider keys — read by litellm/config.yaml via os.environ/...
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ---- web push (VAPID) — phase 8 ----
MHSQUARE_VAPID_PUBLIC_KEY=
MHSQUARE_VAPID_PRIVATE_KEY=

# ---- host ports (all bound to 127.0.0.1) ----
UI_HOST_PORT=8080
API_HOST_PORT=8000
LITELLM_HOST_PORT=4000
